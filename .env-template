# Geo-Brain Environment Template
# WARNING: Do NOT commit .env to version control!
# Copy this to .env and replace all empty secrets with unique values.
# Generate secrets with: openssl rand -base64 32

DOMAIN=example.local
PUID=1000                               # Container executor UID (run: id -u)
PGID=1000                               # Container executor GID (run: id -g)
DATA_DIR=~/Brain-Data
PODMAN_SOCK=/run/user/1000/podman/podman.sock

# Kanidm / Identity
LDAP_BASE_DN=dc=example,dc=local

# Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=                    # GENERATE: openssl rand -base64 32

# Registry
QUAY_DB_USER=quayuser
QUAY_DB_PASSWORD=                       # GENERATE: openssl rand -base64 32
QUAY_DB_NAME=quay
QUAY_SECRET_KEY=                        # GENERATE: openssl rand -base64 32
QUAY_DB_SECRET_KEY=                     # GENERATE: openssl rand -base64 32
CLAIR_DB_USER=clairuser
CLAIR_DB_PASSWORD=                      # GENERATE: openssl rand -base64 32
CLAIR_DB_NAME=clair

# Security
ADMIN_PASSWORD=                          # GENERATE: openssl rand -base64 32 (Quay admin init)
CROWDSEC_BOUNCER_API_KEY=               # GENERATE: openssl rand -base64 32
DEFECTDOJO_DB_USER=defectdojo
DEFECTDOJO_DB_PASSWORD=                 # GENERATE: openssl rand -base64 32
DEFECTDOJO_ADMIN_PASSWORD=              # GENERATE: openssl rand -base64 32
WAZUH_API_PASSWORD=                     # GENERATE: openssl rand -base64 32
POSTGRES_PASSWORD=                      # GENERATE: openssl rand -base64 32
REDIS_PASSWORD=                         # GENERATE: openssl rand -base64 32

# Remote Deployment
REMOTE_HOST=
REMOTE_USER=
SSH_KEY=~/.ssh/id_ed25519
SSH_PORT=22

# --- Auto-generated by setup-brain.sh ---
# Do NOT set these manually; setup-brain.sh writes them.
KANIDM_ADMIN_PASSWORD=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
QUAY_OIDC_SECRET=
MINIO_OIDC_SECRET=
WAZUH_OIDC_SECRET=
DOJO_OIDC_SECRET=
DOJO_SECRET_KEY=
N8N_OIDC_SECRET=

# Developer Tools (Optional — deploy with: ./deploy.sh dev up)
PKG_SENTINEL_TIMEOUT=15s
PKG_SENTINEL_DEFAULT_ACTION=block
PKG_SENTINEL_SANDBOX_IMAGE=docker.io/library/node:20-alpine
PKG_SENTINEL_LLM_ENDPOINT=
PKG_SENTINEL_NPM_UPSTREAM=https://registry.npmjs.org
PKG_SENTINEL_PYPI_UPSTREAM=https://pypi.org
PKG_SENTINEL_MAVEN_UPSTREAM=https://repo1.maven.org/maven2
