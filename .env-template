# Geo-Brain Environment Template
DOMAIN=example.local
PUID=1000
PGID=1000
DATA_DIR=~/Brain-Data
PODMAN_SOCK=/run/user/1000/podman/podman.sock

# Kanidm / LDAP
LDAP_BASE_DN=dc=example,dc=local
AUTHELIA_LDAP_PASSWORD=SecurePassword123!
AUTHELIA_JWT_SECRET=SecurePassword123!
AUTHELIA_ENCRYPTION_KEY=SecurePassword123ExtendedForProd!

# Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=SecurePassword123!

# Registry
QUAY_DB_USER=quayuser
QUAY_DB_PASSWORD=SecurePassword123!
QUAY_DB_NAME=quay
CLAIR_DB_USER=clairuser
CLAIR_DB_PASSWORD=SecurePassword123!
CLAIR_DB_NAME=clair

# Security
CROWDSEC_BOUNCER_API_KEY=SecurePassword123!
DEFECTDOJO_DB_USER=defectdojo
DEFECTDOJO_DB_PASSWORD=SecurePassword123!
POSTGRES_PASSWORD=SecurePassword123!
REDIS_PASSWORD=SecurePassword123!

# Remote Deployment
REMOTE_HOST=
REMOTE_USER=
SSH_KEY=~/.ssh/id_ed25519
SSH_PORT=22

# --- OIDC & Secret Management ---
# These are generated automatically by setup-brain.sh
QUAY_OIDC_SECRET=
MINIO_OIDC_SECRET=
WAZUH_OIDC_SECRET=
DOJO_OIDC_SECRET=
DOJO_SECRET_KEY=
N8N_OIDC_SECRET=
