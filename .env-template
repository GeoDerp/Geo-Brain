# Geo-Brain Environment Template
# WARNING: Do NOT commit .env to version control!
# Copy this to .env and replace all empty secrets with unique values.
# Generate secrets with: openssl rand -base64 32

DOMAIN=example.local
PUID=1000                               # Container executor UID (run: id -u)
PGID=1000                               # Container executor GID (run: id -g)
DATA_DIR=~/Brain-Data
PODMAN_SOCK=/run/user/1000/podman/podman.sock

# Kanidm / LDAP
LDAP_BASE_DN=dc=example,dc=local
AUTHELIA_LDAP_PASSWORD=                 # GENERATE: openssl rand -base64 32
AUTHELIA_JWT_SECRET=                    # GENERATE: openssl rand -base64 32
AUTHELIA_ENCRYPTION_KEY=                # GENERATE: openssl rand -base64 48

# Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=                    # GENERATE: openssl rand -base64 32

# Registry
QUAY_DB_USER=quayuser
QUAY_DB_PASSWORD=                       # GENERATE: openssl rand -base64 32
QUAY_DB_NAME=quay
CLAIR_DB_USER=clairuser
CLAIR_DB_PASSWORD=                      # GENERATE: openssl rand -base64 32
CLAIR_DB_NAME=clair

# Security
CROWDSEC_BOUNCER_API_KEY=               # GENERATE: openssl rand -base64 32
DEFECTDOJO_DB_USER=defectdojo
DEFECTDOJO_DB_PASSWORD=                 # GENERATE: openssl rand -base64 32
POSTGRES_PASSWORD=                      # GENERATE: openssl rand -base64 32
REDIS_PASSWORD=                         # GENERATE: openssl rand -base64 32

# Remote Deployment
REMOTE_HOST=
REMOTE_USER=
SSH_KEY=~/.ssh/id_ed25519
SSH_PORT=22

# --- OIDC & Secret Management ---
# These are generated automatically by setup-brain.sh
QUAY_OIDC_SECRET=
MINIO_OIDC_SECRET=
WAZUH_OIDC_SECRET=
DOJO_OIDC_SECRET=
DOJO_SECRET_KEY=
N8N_OIDC_SECRET=
