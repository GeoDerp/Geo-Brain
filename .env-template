# =============================================================================
# GEO-Brain SSOF — Global Environment Variables
# =============================================================================
# Copy this file to .env and update all CHANGE_ME values before deployment.
#
#   cp .env-template .env
#   chmod 600 .env
#
# DISA STIG Compliance Notes:
#   - Never commit .env with real credentials to source control.
#   - All passwords must be unique, 16+ characters, mixed-case alphanumeric.
#   - Rotate secrets on a defined schedule (e.g., 90 days).
#   - File permissions on .env must be 600 (owner read/write only).
# =============================================================================

# -----------------------------------------------------------------------------
# Global
# -----------------------------------------------------------------------------
# Top-level domain used across all stacks for labels, routing, and certs.
DOMAIN=example.local

# Rootless Podman socket path. Set by init-node.sh; override if non-standard.
PODMAN_SOCK=/run/user/1000/podman/podman.sock

# Default UID:GID for rootless containers. Must match the host user running
# Podman. Override per-stack only if a specific image requires it.
PUID=1000
PGID=1000

# -----------------------------------------------------------------------------
# LDAP / Identity (Kanidm → Authelia)
# -----------------------------------------------------------------------------
# LDAP Base DN derived from your DOMAIN (e.g., example.local → dc=example,dc=local).
LDAP_BASE_DN=dc=example,dc=local

# Authelia service-account password for Kanidm LDAP bind.
AUTHELIA_LDAP_PASSWORD=CHANGE_ME_authelia_ldap_password

# -----------------------------------------------------------------------------
# Step-CA (Internal PKI)
# -----------------------------------------------------------------------------
# Human-readable CA name shown in issued certificates.
# STEPCA_CA_NAME=${DOMAIN} CA

# -----------------------------------------------------------------------------
# MinIO (S3 Object Storage)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password

# -----------------------------------------------------------------------------
# DefectDojo (Vulnerability Management)
# -----------------------------------------------------------------------------
DEFECTDOJO_DB_USER=defectdojo
DEFECTDOJO_DB_PASSWORD=CHANGE_ME_defectdojo_password

# -----------------------------------------------------------------------------
# CrowdSec (Intrusion Prevention)
# -----------------------------------------------------------------------------
# Bouncer API key — generate with: cscli bouncers add traefik-bouncer
CROWDSEC_BOUNCER_API_KEY=CHANGE_ME_crowdsec_bouncer_key

# -----------------------------------------------------------------------------
# Wazuh (SIEM/XDR)
# -----------------------------------------------------------------------------
# JVM heap for the OpenSearch indexer (format: -Xms<size> -Xmx<size>).
# WAZUH_INDEXER_JAVA_OPTS=-Xms512m -Xmx512m

# -----------------------------------------------------------------------------
# RamaLama (AI Log Analysis)
# -----------------------------------------------------------------------------
# LLM model served for air-gapped security analysis.
# RAMALAMA_MODEL=phi3:mini
# RAMALAMA_TRANSPORT=local
